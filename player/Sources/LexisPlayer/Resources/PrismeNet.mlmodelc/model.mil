program(1.0)
[buildInfo = dict<tensor<string, []>, tensor<string, []>>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-torch", "2.7.1"}, {"coremltools-source-dialect", "TorchScript"}, {"coremltools-version", "9.0"}})]
{
    func main<ios17>(tensor<fp16, [1, 1, 1088, 1920]> luma, tensor<fp16, [1, 1, 1, 1]> strength) {
            tensor<uint32, []> input_1_downscale_factor_0 = const()[name = tensor<string, []>("input_1_downscale_factor_0"), val = tensor<uint32, []>(2)];
            tensor<fp16, [1, 4, 544, 960]> input_1_cast_fp16 = pixel_unshuffle(downscale_factor = input_1_downscale_factor_0, x = luma)[name = tensor<string, []>("input_1_cast_fp16")];
            tensor<string, []> h_pad_type_0 = const()[name = tensor<string, []>("h_pad_type_0"), val = tensor<string, []>("custom")];
            tensor<int32, [4]> h_pad_0 = const()[name = tensor<string, []>("h_pad_0"), val = tensor<int32, [4]>([1, 1, 1, 1])];
            tensor<int32, [2]> h_strides_0 = const()[name = tensor<string, []>("h_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [2]> h_dilations_0 = const()[name = tensor<string, []>("h_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, []> h_groups_0 = const()[name = tensor<string, []>("h_groups_0"), val = tensor<int32, []>(1)];
            tensor<fp16, [32, 4, 3, 3]> first_weight_to_fp16 = const()[name = tensor<string, []>("first_weight_to_fp16"), val = tensor<fp16, [32, 4, 3, 3]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(64)))];
            tensor<fp16, [32]> first_bias_to_fp16 = const()[name = tensor<string, []>("first_bias_to_fp16"), val = tensor<fp16, [32]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(2432)))];
            tensor<fp16, [1, 32, 544, 960]> h_cast_fp16 = conv(bias = first_bias_to_fp16, dilations = h_dilations_0, groups = h_groups_0, pad = h_pad_0, pad_type = h_pad_type_0, strides = h_strides_0, weight = first_weight_to_fp16, x = input_1_cast_fp16)[name = tensor<string, []>("h_cast_fp16")];
            tensor<fp16, [1, 32, 1, 1]> folds_0_to_fp16 = const()[name = tensor<string, []>("folds_0_to_fp16"), val = tensor<fp16, [1, 32, 1, 1]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(2560)))];
            tensor<fp16, [1, 32, 1, 1]> var_30_cast_fp16 = mul(x = strength, y = folds_0_to_fp16)[name = tensor<string, []>("op_30_cast_fp16")];
            tensor<fp16, [1, 32, 544, 960]> input_3_cast_fp16 = add(x = h_cast_fp16, y = var_30_cast_fp16)[name = tensor<string, []>("input_3_cast_fp16")];
            tensor<fp16, [1, 32, 544, 960]> input_5_cast_fp16 = relu(x = input_3_cast_fp16)[name = tensor<string, []>("input_5_cast_fp16")];
            tensor<string, []> input_7_pad_type_0 = const()[name = tensor<string, []>("input_7_pad_type_0"), val = tensor<string, []>("custom")];
            tensor<int32, [4]> input_7_pad_0 = const()[name = tensor<string, []>("input_7_pad_0"), val = tensor<int32, [4]>([1, 1, 1, 1])];
            tensor<int32, [2]> input_7_strides_0 = const()[name = tensor<string, []>("input_7_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [2]> input_7_dilations_0 = const()[name = tensor<string, []>("input_7_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, []> input_7_groups_0 = const()[name = tensor<string, []>("input_7_groups_0"), val = tensor<int32, []>(1)];
            tensor<fp16, [32, 32, 3, 3]> n_body_2_weight_to_fp16 = const()[name = tensor<string, []>("n_body_2_weight_to_fp16"), val = tensor<fp16, [32, 32, 3, 3]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(2688)))];
            tensor<fp16, [32]> n_body_2_bias_to_fp16 = const()[name = tensor<string, []>("n_body_2_bias_to_fp16"), val = tensor<fp16, [32]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(21184)))];
            tensor<fp16, [1, 32, 544, 960]> input_7_cast_fp16 = conv(bias = n_body_2_bias_to_fp16, dilations = input_7_dilations_0, groups = input_7_groups_0, pad = input_7_pad_0, pad_type = input_7_pad_type_0, strides = input_7_strides_0, weight = n_body_2_weight_to_fp16, x = input_5_cast_fp16)[name = tensor<string, []>("input_7_cast_fp16")];
            tensor<fp16, [1, 32, 544, 960]> input_9_cast_fp16 = relu(x = input_7_cast_fp16)[name = tensor<string, []>("input_9_cast_fp16")];
            tensor<string, []> input_11_pad_type_0 = const()[name = tensor<string, []>("input_11_pad_type_0"), val = tensor<string, []>("custom")];
            tensor<int32, [4]> input_11_pad_0 = const()[name = tensor<string, []>("input_11_pad_0"), val = tensor<int32, [4]>([1, 1, 1, 1])];
            tensor<int32, [2]> input_11_strides_0 = const()[name = tensor<string, []>("input_11_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [2]> input_11_dilations_0 = const()[name = tensor<string, []>("input_11_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, []> input_11_groups_0 = const()[name = tensor<string, []>("input_11_groups_0"), val = tensor<int32, []>(1)];
            tensor<fp16, [32, 32, 3, 3]> n_body_4_weight_to_fp16 = const()[name = tensor<string, []>("n_body_4_weight_to_fp16"), val = tensor<fp16, [32, 32, 3, 3]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(21312)))];
            tensor<fp16, [32]> n_body_4_bias_to_fp16 = const()[name = tensor<string, []>("n_body_4_bias_to_fp16"), val = tensor<fp16, [32]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(39808)))];
            tensor<fp16, [1, 32, 544, 960]> input_11_cast_fp16 = conv(bias = n_body_4_bias_to_fp16, dilations = input_11_dilations_0, groups = input_11_groups_0, pad = input_11_pad_0, pad_type = input_11_pad_type_0, strides = input_11_strides_0, weight = n_body_4_weight_to_fp16, x = input_9_cast_fp16)[name = tensor<string, []>("input_11_cast_fp16")];
            tensor<fp16, [1, 32, 544, 960]> input_13_cast_fp16 = relu(x = input_11_cast_fp16)[name = tensor<string, []>("input_13_cast_fp16")];
            tensor<string, []> input_15_pad_type_0 = const()[name = tensor<string, []>("input_15_pad_type_0"), val = tensor<string, []>("custom")];
            tensor<int32, [4]> input_15_pad_0 = const()[name = tensor<string, []>("input_15_pad_0"), val = tensor<int32, [4]>([1, 1, 1, 1])];
            tensor<int32, [2]> input_15_strides_0 = const()[name = tensor<string, []>("input_15_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [2]> input_15_dilations_0 = const()[name = tensor<string, []>("input_15_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, []> input_15_groups_0 = const()[name = tensor<string, []>("input_15_groups_0"), val = tensor<int32, []>(1)];
            tensor<fp16, [32, 32, 3, 3]> n_body_6_weight_to_fp16 = const()[name = tensor<string, []>("n_body_6_weight_to_fp16"), val = tensor<fp16, [32, 32, 3, 3]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(39936)))];
            tensor<fp16, [32]> n_body_6_bias_to_fp16 = const()[name = tensor<string, []>("n_body_6_bias_to_fp16"), val = tensor<fp16, [32]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(58432)))];
            tensor<fp16, [1, 32, 544, 960]> input_15_cast_fp16 = conv(bias = n_body_6_bias_to_fp16, dilations = input_15_dilations_0, groups = input_15_groups_0, pad = input_15_pad_0, pad_type = input_15_pad_type_0, strides = input_15_strides_0, weight = n_body_6_weight_to_fp16, x = input_13_cast_fp16)[name = tensor<string, []>("input_15_cast_fp16")];
            tensor<fp16, [1, 32, 544, 960]> input_cast_fp16 = relu(x = input_15_cast_fp16)[name = tensor<string, []>("input_cast_fp16")];
            tensor<fp32, []> var_74_scale_factor_height_0 = const()[name = tensor<string, []>("op_74_scale_factor_height_0"), val = tensor<fp32, []>(0x1p+1)];
            tensor<fp32, []> var_74_scale_factor_width_0 = const()[name = tensor<string, []>("op_74_scale_factor_width_0"), val = tensor<fp32, []>(0x1p+1)];
            tensor<fp16, [1, 1, 2176, 3840]> var_74_cast_fp16 = upsample_nearest_neighbor(scale_factor_height = var_74_scale_factor_height_0, scale_factor_width = var_74_scale_factor_width_0, x = luma)[name = tensor<string, []>("op_74_cast_fp16")];
            tensor<string, []> var_85_pad_type_0 = const()[name = tensor<string, []>("op_85_pad_type_0"), val = tensor<string, []>("custom")];
            tensor<int32, [4]> var_85_pad_0 = const()[name = tensor<string, []>("op_85_pad_0"), val = tensor<int32, [4]>([1, 1, 1, 1])];
            tensor<int32, [2]> var_85_strides_0 = const()[name = tensor<string, []>("op_85_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [2]> var_85_dilations_0 = const()[name = tensor<string, []>("op_85_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, []> var_85_groups_0 = const()[name = tensor<string, []>("op_85_groups_0"), val = tensor<int32, []>(1)];
            tensor<fp16, [16, 32, 3, 3]> n_tail_weight_to_fp16 = const()[name = tensor<string, []>("n_tail_weight_to_fp16"), val = tensor<fp16, [16, 32, 3, 3]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(58560)))];
            tensor<fp16, [16]> n_tail_bias_to_fp16 = const()[name = tensor<string, []>("n_tail_bias_to_fp16"), val = tensor<fp16, [16]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(67840)))];
            tensor<fp16, [1, 16, 544, 960]> var_85_cast_fp16 = conv(bias = n_tail_bias_to_fp16, dilations = var_85_dilations_0, groups = var_85_groups_0, pad = var_85_pad_0, pad_type = var_85_pad_type_0, strides = var_85_strides_0, weight = n_tail_weight_to_fp16, x = input_cast_fp16)[name = tensor<string, []>("op_85_cast_fp16")];
            tensor<int32, []> var_86 = const()[name = tensor<string, []>("op_86"), val = tensor<int32, []>(4)];
            tensor<fp16, [1, 1, 2176, 3840]> var_87_cast_fp16 = pixel_shuffle(upscale_factor = var_86, x = var_85_cast_fp16)[name = tensor<string, []>("op_87_cast_fp16")];
            tensor<fp16, [1, 1, 2176, 3840]> scaled = add(x = var_74_cast_fp16, y = var_87_cast_fp16)[name = tensor<string, []>("op_89_cast_fp16")];
        } -> (scaled);
}